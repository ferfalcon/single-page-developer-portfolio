---
import { getImage, Image } from 'astro:assets';

import profileMobile from '../assets/portfolio/images/image-profile-mobile.webp';
import profileTablet from '../assets/portfolio/images/image-profile-tablet.webp';
import profileDesktop from '../assets/portfolio/images/image-profile-desktop.webp';

import { portfolio } from '../data/portfolio';

import '../styles/hero.css';

const desktopImage = await getImage({
  src: profileDesktop,
  format: 'webp',
});

const tabletImage = await getImage({
  src: profileTablet,
  format: 'webp',
});
---

<section class="hero" aria-labelledby="hero-heading">
  <picture class="hero__portrait">
    <source media="(min-width: 75rem)" srcset={desktopImage.src} />
    <source media="(min-width: 45rem)" srcset={tabletImage.src} />
    <Image src={profileMobile} alt={portfolio.hero.portraitAlt} priority />
  </picture>

  <div class="hero__inner site-container">
    <div class="hero__content">
      <h1 id="hero-heading">
        Nice to meet you! I’m <span class="hero__name">Adam Keyes.</span>
      </h1>
      <p>
        Based in the UK, I’m a front-end developer passionate about building accessible web apps that users love.
      </p>
      <a class="text-action" href={portfolio.hero.contactHref}>Contact me</a>
    </div>
  </div>
</section>
