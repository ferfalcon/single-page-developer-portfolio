---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';

import circlePattern from '../assets/portfolio/images/pattern-circle.svg';
import ringsPattern from '../assets/portfolio/images/pattern-rings.svg';

import '../styles/portfolio.css';
---

<Layout>
  <PortfolioHeader />
  <main class="portfolio-main">
    <div class="portfolio-intro">
      <Hero />
      <img class="portfolio-intro__rings" src={ringsPattern.src} alt="" aria-hidden="true" />
      <img class="portfolio-intro__circle" src={circlePattern.src} alt="" aria-hidden="true" />
    </div>
    <Skills />
    <Projects />
    <ContactForm />
  </main>
  <PortfolioFooter />
</Layout>
